    "seed": "bun src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12",
    "@nestjs/platform-express": "^12",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/cli": "^12",
    "@nestjs/schematics": "^12",
    "@nestjs/testing": "^12",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
