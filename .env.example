# Read by docker compose. Copy to .env and fill in.
AUTH_SECRET=
ADMIN_EMAILS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host ports, change one if it is already taken locally.
# The subject requires the API on 8080, keep it unless you must.
# If you change WEB_PORT, set WEB_URL to the same port.
DB_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
API_PORT=8080
WEB_PORT=8081
